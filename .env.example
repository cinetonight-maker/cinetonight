# TMDB credentials — get them at https://www.themoviedb.org/settings/api
# Set EITHER of these (the v3 API key is the simplest), then run:  npm run sync

TMDB_API_KEY=
# TMDB_READ_TOKEN=

# Supabase — admin dashboard (dashboard.supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Your real production domain, no trailing slash (e.g. https://moviex.example.com).
# Used by app/sitemap.ts and app/robots.ts so search engines index the right
# URLs — without this, the sitemap falls back to the Vercel preview URL or
# localhost, which is not what you want indexed.
NEXT_PUBLIC_SITE_URL=
